<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jornada de trabajo</title>
  <style>
    :root {
      --bg: #eef1f4; --surface: #ffffff; --ink: #1b2430; --muted: #5d6b7b;
      --line: #d3dae2; --run: #0f6e5b; --run-ink: #ffffff; --stop: #b3402f; --wash: #e3f1ed;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #12171d; --surface: #1b222b; --ink: #e8edf2; --muted: #93a1b0;
        --line: #2d3743; --run: #3fb89c; --run-ink: #06201a; --stop: #e57b6a; --wash: #183a33;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--ink);
      font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    main { max-width: 720px; margin: 0 auto; display: grid; gap: 16px; }
    h1 { font-size: 1.25rem; margin: 0 0 4px; }
    h2 { font-size: 1rem; margin: 0 0 12px; }
    p { margin: 0; color: var(--muted); }
    .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
    .num { font-variant-numeric: tabular-nums; }

    /* Empleado */
    .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
    label { display: grid; gap: 4px; font-size: .875rem; color: var(--muted); }
    .meta { margin: 16px 0 0; display: grid; gap: 8px; }
    .meta > div { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding-top: 8px; }
    .meta dt { color: var(--muted); }
    .meta dd { margin: 0; text-align: right; overflow-wrap: anywhere; }
    .msg { color: var(--stop); font-size: .875rem; margin-top: 12px; }

    /* Estado actual */
    .status { display: grid; gap: 16px; }
    .status-row { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-end; justify-content: space-between; }
    .big { font-size: 3rem; font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
    .label { font-size: .875rem; color: var(--muted); }
    .current { font-size: 1.25rem; font-weight: 600; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; }
    button { font: inherit; cursor: pointer; }
    .btn {
      padding: 10px 18px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--surface); color: var(--ink); font-weight: 600;
    }
    .btn:disabled { cursor: wait; opacity: .6; }
    .btn-run { background: var(--run); border-color: var(--run); color: var(--run-ink); }
    .btn-stop { background: var(--stop); border-color: var(--stop); color: #fff; }
    :focus-visible { outline: 3px solid var(--run); outline-offset: 2px; }

    /* Actividades */
    form { display: flex; gap: 8px; margin-bottom: 16px; }
    input[type=text] {
      flex: 1; min-width: 0; padding: 10px 12px; font: inherit; color: var(--ink);
      background: var(--bg); border: 1px solid var(--line); border-radius: 8px;
    }
    input:disabled { opacity: .7; }
    ul { list-style: none; margin: 0; padding: 0; }
    .chips { display: grid; gap: 8px; }
    .chip-row { display: flex; gap: 6px; }
    .chip {
      flex: 1; display: flex; justify-content: space-between; align-items: center; gap: 12px;
      text-align: left; padding: 12px 14px; border-radius: 8px;
      border: 1px solid var(--line); background: var(--surface); color: var(--ink);
    }
    .chip[aria-pressed=true] { background: var(--wash); border-color: var(--run); border-left-width: 6px; }
    .chip:disabled { cursor: not-allowed; opacity: .6; }
    .chip .name { font-weight: 600; overflow-wrap: anywhere; }
    .remove {
      width: 44px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--surface); color: var(--muted); font-size: 1.25rem;
    }
    .hint { font-size: .875rem; margin-top: 12px; }

    /* Registro y resumen */
    .log li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-top: 1px solid var(--line); }
    .log li:first-child { border-top: 0; }
    .sum-row { padding: 10px 0; border-top: 1px solid var(--line); }
    .sum-row:first-child { border-top: 0; }
    .sum-top { display: flex; justify-content: space-between; gap: 12px; font-weight: 600; }
    .bar { height: 8px; margin-top: 6px; background: var(--bg); border-radius: 4px; overflow: hidden; }
    .bar > span { display: block; height: 100%; background: var(--run); }
    [hidden] { display: none !important; }
  </style>
</head>
<body
  data-save-url="<%= typeof saveUrl !== 'undefined' ? saveUrl : '' %>"
  data-ip="<%= typeof ip !== 'undefined' && ip ? ip : '' %>"
  data-emp-number="<%= typeof empleado !== 'undefined' && empleado && empleado.numero ? empleado.numero : '' %>"
  data-emp-name="<%= typeof empleado !== 'undefined' && empleado && empleado.nombre ? empleado.nombre : '' %>">
<main>
  <header>
    <h1>Jornada de trabajo</h1>
    <p id="intro"></p>
  </header>

  <section class="panel" id="employee-panel">
    <h2>Datos del empleado</h2>
    <div class="fields">
      <label>Número de empleado
        <input type="text" id="emp-number" maxlength="20" autocomplete="off">
      </label>
      <label>Nombre del empleado
        <input type="text" id="emp-name" maxlength="80" autocomplete="name">
      </label>
    </div>
    <dl class="meta">
      <div><dt>IP de acceso</dt><dd class="num" id="meta-ip"></dd></div>
      <div><dt>Ubicación de entrada</dt><dd class="num" id="meta-loc-in"></dd></div>
      <div id="row-loc-out" hidden><dt>Ubicación de salida</dt><dd class="num" id="meta-loc-out"></dd></div>
    </dl>
    <p class="msg" id="check-msg" role="alert" hidden></p>
  </section>

  <section class="panel status" aria-live="polite">
    <div class="status-row">
      <div>
        <div class="label">Tiempo de jornada</div>
        <div class="big num" id="total">00:00:00</div>
      </div>
      <div>
        <div class="label" id="state-label">Estado</div>
        <div class="current" id="state-name">Sin jornada iniciada</div>
        <div class="num label" id="state-time"></div>
      </div>
    </div>
    <div class="actions">
      <button type="button" class="btn btn-run" id="btn-in">Checar entrada</button>
      <button type="button" class="btn btn-stop" id="btn-out" hidden>Checar salida</button>
      <button type="button" class="btn" id="btn-new" hidden>Nueva jornada</button>
    </div>
    <p class="hint" id="sync-status" role="status" style="margin-top: 0;"></p>
  </section>

  <section class="panel" id="activities-panel">
    <h2>Actividades</h2>
    <form id="form-activity" autocomplete="off">
      <input type="text" id="activity-name" maxlength="40" placeholder="Escribe una actividad, por ejemplo: Reunión" aria-label="Nombre de la actividad" required>
      <button type="submit" class="btn">Agregar</button>
    </form>
    <ul class="chips" id="chips"></ul>
    <p class="hint" id="chips-hint"></p>
  </section>

  <section class="panel" id="summary-panel" hidden>
    <h2>Resumen de la jornada</h2>
    <div id="summary"></div>
    <p class="hint" id="save-status" role="status"></p>
    <div class="actions" style="margin-top: 8px;">
      <button type="button" class="btn" id="btn-retry" hidden>Reintentar guardado</button>
    </div>
  </section>

  <section class="panel" id="log-panel" hidden>
    <h2>Cambios de estado</h2>
    <ul class="log" id="log"></ul>
  </section>
</main>

<script>
(function () {
  'use strict';

  /* Cambia a true si quieres impedir checar entrada sin permiso de ubicación. */
  var REQUIRE_LOCATION = false;

  var IDLE = '__idle';
  var IDLE_LABEL = 'Sin asignar';
  var KEY_SHIFT = 'journey3.shift';
  var KEY_ACTS = 'journey.activities';
  var KEY_EMP = 'journey2.employee';

  // Si la vista se renderiza sin saveUrl, se usa esta ruta por defecto (antes no se enviaba nada y no avisaba).
  var saveUrl = document.body.dataset.saveUrl || '/journey3/sync';
  var serverIp = document.body.dataset.ip;
  var serverEmp = { numero: document.body.dataset.empNumber, nombre: document.body.dataset.empName };
  var locked = !!(serverEmp.numero && serverEmp.nombre); // el servidor ya identifica al empleado

  /* ---------- Persistencia (se conserva si recargas la página) ---------- */
  function load(key, fallback) {
    try {
      var raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch (e) { return fallback; }
  }
  function store(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* sin almacenamiento */ }
  }

  var activities = load(KEY_ACTS, []);
  var shift = load(KEY_SHIFT, null); // { empleado, start, end, current, since, totals, log, locIn, locOut, locOutReady, saved }
  var emp = locked ? serverEmp : load(KEY_EMP, { numero: '', nombre: '' });

  // Si se cerró la página antes de obtener la ubicación de salida, se marca como no obtenida.
  if (shift && shift.end && !shift.locOutReady) {
    shift.locOut = { estado: 'no_obtenida' };
    shift.locOutReady = true;
    shift.rev = (shift.rev || 0) + 1;
    shift.dirty = true;
    store(KEY_SHIFT, shift);
  }

  /* ---------- Utilidades ---------- */
  function $(id) { return document.getElementById(id); }
  function labelOf(id) { return id === IDLE ? IDLE_LABEL : id; }
  function isActive() { return !!shift && !shift.end; }

  function fmt(ms) {
    var s = Math.max(0, Math.floor(ms / 1000));
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
    return [h, m, sec].map(function (n) { return String(n).padStart(2, '0'); }).join(':');
  }
  function clock(ts) {
    return new Date(ts).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }
  function totalFor(id, at) {
    var t = (shift && shift.totals[id]) || 0;
    if (isActive() && shift.current === id) t += at - shift.since;
    return t;
  }
  function persist() { store(KEY_SHIFT, shift); }

  /* ---------- Ubicación ---------- */
  // Nunca rechaza: siempre devuelve un objeto con "estado".
  function getLocation() {
    return new Promise(function (resolve) {
      if (!('geolocation' in navigator)) return resolve({ estado: 'no_disponible' });
      navigator.geolocation.getCurrentPosition(
        function (p) {
          resolve({
            estado: 'ok',
            lat: p.coords.latitude,
            lng: p.coords.longitude,
            precision: p.coords.accuracy,
            fecha: new Date(p.timestamp).toISOString()
          });
        },
        function (err) {
          resolve({ estado: err.code === 1 ? 'denegada' : (err.code === 3 ? 'tiempo_agotado' : 'no_disponible') });
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      );
    });
  }

  function locText(l) {
    if (!l) return 'Sin datos';
    if (l.estado === 'ok') {
      return l.lat.toFixed(5) + ', ' + l.lng.toFixed(5) + ' (±' + Math.round(l.precision) + ' m)';
    }
    return ({
      denegada: 'Permiso de ubicación denegado',
      tiempo_agotado: 'No se obtuvo a tiempo',
      no_disponible: 'No disponible en este dispositivo',
      no_obtenida: 'No se obtuvo'
    })[l.estado] || 'Sin datos';
  }

  function setMsg(text) {
    var el = $('check-msg');
    el.textContent = text || '';
    el.hidden = !text;
  }

  /* ---------- Lógica de la jornada ---------- */
  function closeSegment(at) {
    var d = at - shift.since;
    shift.totals[shift.current] = (shift.totals[shift.current] || 0) + d;
    if (d >= 500) shift.log.push({ a: shift.current, s: shift.since, e: at });
  }

  function checkIn() {
    var numero = $('emp-number').value.trim();
    var nombre = $('emp-name').value.trim().replace(/\s+/g, ' ');
    if (!numero || !nombre) {
      setMsg('Escribe tu número y tu nombre de empleado para checar entrada.');
      (numero ? $('emp-name') : $('emp-number')).focus();
      return;
    }

    var t = Date.now(); // la hora de entrada es la del clic, no la de la respuesta de ubicación
    var btn = $('btn-in');
    btn.disabled = true;
    setMsg('');
    $('meta-loc-in').textContent = 'Obteniendo ubicación…';

    getLocation().then(function (loc) {
      btn.disabled = false;
      if (REQUIRE_LOCATION && loc.estado !== 'ok') {
        setMsg('Necesitas permitir la ubicación para checar entrada. ' + locText(loc) + '.');
        render();
        return;
      }
      shift = {
        jornadaId: newId(),
        empleado: { numero: numero, nombre: nombre },
        start: t, end: null, current: IDLE, since: t, totals: {}, log: [],
        locIn: loc, locOut: null, locOutReady: false,
        rev: 0, dirty: false, saved: false
      };
      markChange(); render();
    });
  }

  function switchTo(id) {
    if (!isActive() || shift.current === id) return;
    var t = Date.now();
    closeSegment(t);
    shift.current = id;
    shift.since = t;
    markChange(); render(); // avisa al servidor del cambio de actividad
  }

  function checkOut() {
    if (!isActive()) return;
    var t = Date.now();
    closeSegment(t);
    shift.end = t;
    shift.locOutReady = false;
    markChange(); render(); // primero se registra la salida

    // La ubicación de salida se pide después, para no retrasar la hora de salida.
    getLocation().then(function (loc) {
      shift.locOut = loc;
      shift.locOutReady = true;
      markChange(); render(); // y luego se completa con la ubicación
    });
  }

  function newShift() {
    if (shift && shift.end && saveUrl && !shift.saved &&
        !confirm('Esta jornada aún no se guardó en la base de datos. ¿Empezar una nueva de todos modos?')) return;
    shift = null;
    setMsg('');
    persist(); render();
  }

  function addActivity(name) {
    name = name.trim().replace(/\s+/g, ' ');
    if (!name) return;
    var exists = activities.some(function (a) { return a.toLowerCase() === name.toLowerCase(); });
    if (!exists && name.toLowerCase() !== IDLE_LABEL.toLowerCase()) {
      activities.push(name);
      store(KEY_ACTS, activities);
    }
    render();
  }

  function removeActivity(name) {
    activities = activities.filter(function (a) { return a !== name; });
    store(KEY_ACTS, activities);
    render();
  }

  /* ---------- Sincronización con el servidor ---------- */
  // En cada cambio (entrada, cambio de actividad, salida) se envía una "foto" completa
  // de la jornada. El servidor la guarda en MongoDB Atlas usando el jornadaId, así que
  // reenviarla es seguro. La conexión a Atlas (URI del .env) la hace el SERVIDOR; el
  // navegador nunca ve ese dato. La IP tampoco se envía: la toma el servidor (req.ip).
  var syncing = false;
  var syncError = false;
  var syncMsg = '';
  var RETRY_MS = 15000;

  // Convierte una respuesta con error en un mensaje legible (incluye el texto que devuelve el servidor).
  function httpError(res) {
    return res.json().catch(function () { return {}; }).then(function (b) {
      var detail = b && b.error ? b.error : (res.status === 404 ? 'la ruta ' + saveUrl + ' no existe en el servidor' : '');
      throw new Error('HTTP ' + res.status + (detail ? ': ' + detail : ''));
    });
  }

  function newId() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return 'j-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
  }

  // Registra que hubo un cambio y lo envía de inmediato.
  function markChange() {
    shift.rev = (shift.rev || 0) + 1;
    shift.dirty = true;
    shift.saved = false;
    persist();
    syncNow();
  }

  function snapshot() {
    var open = !shift.end;
    return {
      jornadaId: shift.jornadaId,
      rev: shift.rev,
      numeroEmpleado: shift.empleado.numero,
      nombreEmpleado: shift.empleado.nombre,
      inicio: new Date(shift.start).toISOString(),
      fin: shift.end ? new Date(shift.end).toISOString() : null,
      abierta: open,
      // Mientras la jornada está abierta, el supervisor suma (ahora - actividadDesde) a la actividad actual.
      actividadActual: open ? labelOf(shift.current) : null,
      actividadDesde: open ? new Date(shift.since).toISOString() : null,
      ubicacionEntrada: shift.locIn,
      ubicacionSalida: shift.locOutReady ? shift.locOut : null,
      actividades: Object.keys(shift.totals).map(function (id) {
        return { nombre: labelOf(id), milisegundos: shift.totals[id] };
      }),
      cambios: shift.log.map(function (l) {
        return { nombre: labelOf(l.a), inicio: new Date(l.s).toISOString(), fin: new Date(l.e).toISOString() };
      })
    };
  }

  function applyRemoteClose(finIso) {
    if (!shift.end) {
      var t = Math.max(new Date(finIso).getTime() || Date.now(), shift.since);
      closeSegment(t);
      shift.end = t;
      shift.locOut = { estado: 'no_obtenida' };
      shift.locOutReady = true;
    }
    shift.cierreManual = true;
    shift.dirty = false;
    shift.saved = true;
    persist();
  }

  function syncNow() {
    if (!saveUrl || !shift || !shift.dirty || syncing) return;
    syncing = true;
    syncError = false;
    renderSyncStatus();
    var sent = snapshot();
    fetch(saveUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(sent)
    })
      .then(function (res) {
        if (!res.ok) return httpError(res);
        return res.json().catch(function () { return {}; }).then(function (body) {
          if (!shift || shift.jornadaId !== sent.jornadaId) return;
          // Un supervisor cerró esta jornada desde el panel: se cierra aquí también.
          if (body && body.cerrada) { applyRemoteClose(body.fin); return; }
          // Solo se marca como sincronizado si no hubo cambios mientras se enviaba.
          if (shift.rev === sent.rev) {
            shift.dirty = false;
            shift.saved = !!shift.end && !!shift.locOutReady;
            persist();
          }
        });
      })
      .catch(function (e) {
        syncError = true;
        syncMsg = (e && e.name === 'TypeError')
          ? 'no se pudo contactar al servidor en ' + saveUrl
          : (e && e.message ? e.message : String(e));
        if (window.console) console.error('Sincronización fallida:', e);
      })
      .then(function () {
        syncing = false;
        render();
        if (shift && shift.dirty && !syncError) syncNow(); // hubo cambios durante el envío
      });
  }

  function renderSyncStatus() {
    var el = $('sync-status');
    var retry = $('btn-retry');
    var status = $('save-status');
    retry.hidden = true;
    status.textContent = '';
    el.textContent = '';
    if (!saveUrl || !shift) return;

    var text;
    if (syncing) text = 'Sincronizando con el servidor…';
    else if (shift.dirty && syncError) text = 'NO se guardó en la base de datos (' + syncMsg + '). Se reintentará automáticamente; tus datos siguen en este navegador.';
    else if (shift.dirty) text = 'Cambios pendientes de enviar…';
    else text = 'Sincronizado con el servidor.';

    if (shift.cierreManual && !shift.dirty) text = 'Un supervisor cerró esta jornada a las ' + clock(shift.end) + '.';

    el.textContent = text;
    if (shift.end) {
      status.textContent = (shift.saved && !shift.cierreManual) ? 'Jornada guardada en la base de datos.' : text;
      retry.hidden = !(shift.dirty && syncError);
    }
  }

  /* ---------- Dibujo de la interfaz ---------- */
  function render() {
    var active = isActive();
    var done = !!shift && !!shift.end;

    $('btn-in').hidden = !!shift;
    $('btn-out').hidden = !active;
    $('btn-new').hidden = !done;

    $('state-label').textContent = done ? 'Jornada terminada' : 'Estado actual';
    $('state-name').textContent = !shift ? 'Sin jornada iniciada' : (done ? 'Salida a las ' + clock(shift.end) : labelOf(shift.current));
    $('intro').textContent = !shift
      ? 'Escribe tus datos y checa entrada para empezar a medir. Mientras tanto puedes preparar tus actividades.'
      : (active ? 'Elige una actividad para cambiar de estado. El tiempo se suma al estado activo.' : 'Revisa cómo repartiste tu tiempo.');

    renderEmployee();
    renderChips(active);
    renderSummary(done);
    renderSyncStatus();
    renderLog();
    tick();
  }

  function renderEmployee() {
    var e = shift ? shift.empleado : emp;
    var num = $('emp-number'), nom = $('emp-name');
    num.value = e.numero;
    nom.value = e.nombre;
    num.disabled = nom.disabled = locked || !!shift;

    $('meta-ip').textContent = serverIp || 'La registra el servidor al guardar';
    $('meta-loc-in').textContent = shift
      ? locText(shift.locIn)
      : (REQUIRE_LOCATION ? 'Se solicita al checar entrada (obligatoria)' : 'Se solicita al checar entrada');

    var done = !!shift && !!shift.end;
    $('row-loc-out').hidden = !done;
    if (done) $('meta-loc-out').textContent = shift.locOutReady ? locText(shift.locOut) : 'Obteniendo ubicación…';
  }

  function renderChips(active) {
    var list = $('chips');
    list.textContent = '';
    var ids = [IDLE].concat(activities);

    ids.forEach(function (id) {
      var li = document.createElement('li');
      li.className = 'chip-row';

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.disabled = !active;
      btn.setAttribute('aria-pressed', String(active && shift.current === id));
      btn.addEventListener('click', function () { switchTo(id); });

      var name = document.createElement('span');
      name.className = 'name';
      name.textContent = labelOf(id);

      var time = document.createElement('span');
      time.className = 'num label';
      time.dataset.chipTime = id;

      btn.appendChild(name);
      btn.appendChild(time);
      li.appendChild(btn);

      if (id !== IDLE) {
        var rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'remove';
        rm.textContent = '×';
        rm.setAttribute('aria-label', 'Quitar la actividad ' + id);
        rm.disabled = active && shift.current === id;
        rm.addEventListener('click', function () { removeActivity(id); });
        li.appendChild(rm);
      }
      list.appendChild(li);
    });

    $('chips-hint').textContent = !shift
      ? 'Las actividades se habilitan al checar entrada.'
      : (activities.length ? '' : 'Escribe tu primera actividad arriba para poder asignarle tiempo.');
  }

  function renderSummary(done) {
    $('summary-panel').hidden = !done;
    var box = $('summary');
    box.textContent = '';
    if (!done) return;

    var total = shift.end - shift.start;
    var ids = Object.keys(shift.totals).sort(function (a, b) { return shift.totals[b] - shift.totals[a]; });

    ids.forEach(function (id) {
      var ms = shift.totals[id];
      var pct = total > 0 ? (ms / total) * 100 : 0;

      var row = document.createElement('div');
      row.className = 'sum-row';

      var top = document.createElement('div');
      top.className = 'sum-top';
      var n = document.createElement('span');
      n.textContent = labelOf(id);
      var v = document.createElement('span');
      v.className = 'num';
      v.textContent = fmt(ms) + ' (' + pct.toFixed(0) + '%)';
      top.appendChild(n);
      top.appendChild(v);

      var bar = document.createElement('div');
      bar.className = 'bar';
      var fill = document.createElement('span');
      fill.style.width = pct.toFixed(1) + '%';
      bar.appendChild(fill);

      row.appendChild(top);
      row.appendChild(bar);
      box.appendChild(row);
    });
  }

  function renderLog() {
    var has = !!shift && shift.log.length > 0;
    $('log-panel').hidden = !has;
    var ul = $('log');
    ul.textContent = '';
    if (!has) return;

    shift.log.slice().reverse().forEach(function (l) {
      var li = document.createElement('li');
      var left = document.createElement('span');
      left.textContent = labelOf(l.a);
      var right = document.createElement('span');
      right.className = 'num label';
      right.textContent = clock(l.s) + ' – ' + clock(l.e) + ' · ' + fmt(l.e - l.s);
      li.appendChild(left);
      li.appendChild(right);
      ul.appendChild(li);
    });
  }

  // Actualiza solo los contadores, sin reconstruir botones.
  function tick() {
    var now = Date.now();
    if (shift) {
      $('total').textContent = fmt((shift.end || now) - shift.start);
      $('state-time').textContent = isActive() ? 'En este estado: ' + fmt(now - shift.since) : '';
    } else {
      $('total').textContent = '00:00:00';
      $('state-time').textContent = '';
    }
    document.querySelectorAll('[data-chip-time]').forEach(function (el) {
      el.textContent = shift ? fmt(totalFor(el.dataset.chipTime, now)) : '';
    });
  }

  /* ---------- Eventos ---------- */
  $('btn-in').addEventListener('click', checkIn);
  $('btn-out').addEventListener('click', function () {
    if (confirm('¿Checar salida y terminar la jornada?')) checkOut();
  });
  $('btn-new').addEventListener('click', newShift);
  $('btn-retry').addEventListener('click', function () { syncError = false; syncNow(); });
  window.addEventListener('online', function () { syncError = false; syncNow(); });
  $('form-activity').addEventListener('submit', function (e) {
    e.preventDefault();
    var input = $('activity-name');
    addActivity(input.value);
    input.value = '';
    input.focus();
  });
  ['emp-number', 'emp-name'].forEach(function (id) {
    $(id).addEventListener('input', function () {
      if (locked || shift) return;
      emp = { numero: $('emp-number').value, nombre: $('emp-name').value };
      store(KEY_EMP, emp);
      setMsg('');
    });
  });

  render();
  if (shift && shift.jornadaId == null) shift.jornadaId = newId(); // jornada guardada por una versión anterior
  syncNow(); // si quedaron cambios sin enviar, se reintentan al abrir la página
  setInterval(tick, 1000);
  setInterval(function () { // reintento periódico; también sirve de "latido" mientras hay cambios pendientes
    if (shift && shift.dirty) { syncError = false; syncNow(); }
  }, RETRY_MS);
})();
</script>
</body>
</html>
